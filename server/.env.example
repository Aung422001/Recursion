PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/recursion
MONGO_URI_TEST=mongodb://127.0.0.1:27017/recursion_test
JWT_ACCESS_SECRET=replace-with-32+-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-32+-char-random-string
CLIENT_ORIGIN=http://localhost:5173

# Pronunciation audio: google-translate (no key, unofficial, dev only) or none
TTS_PROVIDER=google-translate
